  "scripts": {
    "analyze": "yarn build:production && source-map-explorer build/static/js/main.*",
    "start:prod": "cross-env NODE_ENV=production node server/app-server.mjs",
    "start": "node server/app-server.mjs",
    "start-js": "vite",
    "build": "sh -ac '. ./.env; yarn build:scripts'",
    "build:local": "cross-env REACT_APP_ENV=production sh -ac '. ./.env; yarn build:scripts'",
    "build:ssr": "vite build --config vite.ssr.config.js",
    "build:scripts": "vite build && yarn build:ssr",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "yarn run eslint src",
    "lint:fix": "yarn run eslint src --fix",
    "prepare": "husky install",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:update": "BASE_URL=https://kabbalahmedia.info playwright test --update-snapshots"
  },
